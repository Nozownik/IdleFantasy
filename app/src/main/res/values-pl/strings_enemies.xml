    <!-- ===== Dungeon names and descriptions ===== -->
    <string name="dungeon_imp_cavern_name">Jaskinia Grzechotników</string>
    <string name="dungeon_imp_cavern_desc">Płytka jaskinia pełna psotnych chochlików. Idealna dla zupełnie początkujących!</string>
    <string name="dungeon_goblin_cave_name">Kanion Kojotów</string>
    <string name="dungeon_goblin_cave_desc">Mroczna jaskinia zamieszkana przez kojoty i wielkie szczury. Dobre miejsce treningowe dla nowych kowbojów.</string>
    <string name="dungeon_spider_den_name">Gniazdo Skorpionów</string>
    <string name="dungeon_spider_den_desc">Pełna pajęczyn jaskinia roi się od jadowitych pająków. Zabierz odtrutkę!</string>
    <string name="dungeon_bandit_camp_name">Obóz Bandy Daltonów</string>
    <string name="dungeon_bandit_camp_desc">Kryjówka złodziei i łotrzyków na pustkowiu. Miej oko na swoją sakiewkę!</string>
    <string name="dungeon_undead_crypt_name">Cmentarz Boot Hill</string>
    <string name="dungeon_undead_crypt_desc">Starożytne miejsce pochówku, gdzie zmarli nie chcą spocząć w spokoju. Strzeż się mrocznej materiałów wybuchowych!</string>
    <string name="dungeon_fortress_ruins_name">Spalony Fort Union</string>
    <string name="dungeon_fortress_ruins_desc">Rozpadające się pozostałości starożytnego zamku, strzeżone teraz przez rycerzy i żołnierzy.</string>
    <string name="dungeon_orc_stronghold_name">Fort Bandziorów</string>
    <string name="dungeon_orc_stronghold_desc">Ufortyfikowana osada bandziorów głęboko w górach. Tylko odważni ważą się tam wejść.</string>
    <string name="dungeon_volcanic_depths_name">Siarkowe Źródła</string>
    <string name="dungeon_volcanic_depths_desc">Rozpalona jaskinia zamieszkana przez piekielne ogary i pomniejsze demony. Upał jest nie do zniesienia!</string>
    <string name="dungeon_dragon_lair_name">Leże Wielkiego Grizzly</string>
    <string name="dungeon_dragon_lair_desc">Legendarna siedziba zielonych grizzly. Tylko mistrzowie wojownicy przetrwają to wyzwanie.</string>
    <string name="dungeon_farm_name">Opuszczone Ranczo</string>
    <string name="dungeon_farm_desc">Spokojna farma z inwentarzem żywym. Świetna dla początkujących szukających jedzenia!</string>
    <string name="dungeon_infernal_stronghold_name">Piekielne Tombstone</string>
    <string name="dungeon_infernal_stronghold_desc">Twierdza ognia i siarki, rządzona przez demony i piekielne ogary. Sam upał może zabić nieprzygotowanych.</string>
    <string name="dungeon_ancient_temple_name">Kamienne Pueblo</string>
    <string name="dungeon_ancient_temple_desc">Starożytna świątynia strzeżona przez najpotężniejsze stworzenia w krainie. Tylko najsilniejsi wojownicy ważą się tam wejść.</string>
    <string name="dungeon_void_rift_name">Dolina Śmierci</string>
    <string name="dungeon_void_rift_desc">Rozdarcie w rzeczywistości, przez które istoty pustki wdzierają się do śmiertelnego świata.</string>
    <string name="dungeon_frozen_citadel_name">Przełęcz Donnera</string>
    <string name="dungeon_frozen_citadel_desc">Starożytna forteca zamknięta w lodowcu, jej obrońcy zamrożeni w wiecznej czujności.</string>
    <string name="dungeon_abyssal_throne_name">Tron Barona Kolejowego</string>
    <string name="dungeon_abyssal_throne_desc">Najgłębszy punkt znanego świata, rządzony przez władców pustki od zarania dziejów.</string>

    <!-- ===== Event dungeon names ===== -->
    <string name="dungeon_sunspire_name">Mesa Słońca</string> <!-- untranslated -->
    <string name="dungeon_sunspire_desc">A sun-tower ruin cracked open by the solstice, spilling heat spirits into the region. Part of Sun Mesa Solstice event.</string> <!-- untranslated -->
    <string name="dungeon_hollowfen_name">Bagna Luizjany</string> <!-- untranslated -->
    <string name="dungeon_hollowfen_desc">A mist-drowned marsh of sunken barrows where the harvest dead walk. Part of the Gloomharvest event.</string> <!-- untranslated -->
    <string name="dungeon_cloud_kingdom_name">Pociąg Pancerny</string> <!-- untranslated -->
    <string name="dungeon_cloud_kingdom_desc">A frontier above the clouds, reached by climbing a legendary beanstalk. Giants roam vast floating islands, sky serpents drift between the cloudbanks, and storm rattlers crackle with restless energy. Few have seen it. Fewer still have returned to speak of it.</string> <!-- untranslated -->
    <string name="dungeon_blightwood_name">Las Szubienic</string> <!-- untranslated -->
    <string name="dungeon_blightwood_desc">A rotting forest deep past Louisiana Bayou, where the Gloomharvest\'s strongest horrors gather. Part of the Gloomharvest event.</string> <!-- untranslated -->

    <!-- ===== Raid bosses ===== -->
    <string name="boss_king_black_dragon_name">Czarny Grizzly</string>
    <string name="boss_king_black_dragon_desc">Legendarny trójgłowy grizzly, budzący postrach w całym królestwie.</string>
    <string name="boss_demon_lord_name">El Diablo, Król Bandytów</string>
    <string name="boss_demon_lord_desc">Starożytny desert Devil z otchłani, mistrz mrocznej materiałów wybuchowych.</string>
    <string name="boss_kraken_name">Potwór z jeziora Flathead</string> <!-- untranslated -->
    <string name="boss_kraken_desc">Postrach głębokich mórz, kolosalny morski potwór.</string>
    <string name="boss_balrog_name">Gothic Ember, the Burning Oil Well</string> <!-- untranslated -->
    <string name="boss_balrog_desc">Starożytny desert Devil płomienia i cienia, przebudzony ze snu głęboko pod ziemią.</string>
    <string name="boss_void_sovereign_name" translatable="false">Jeździec bez Głowy</string> <!-- untranslated -->
    <string name="boss_void_sovereign_desc">Pierwotna istota stojąca za szczelinami pustki. Niewyobrażalnie stara, patrzy na śmiertelnych śmiałków z pogardą.</string>
    <string name="boss_sol_invictus_name">Sol Invictus, Słoneczny Wódz Mesy</string> <!-- untranslated -->
    <string name="boss_sol_invictus_desc">A shard of the sun itself, torn loose from Sun Mesa ruin. Only the boldest warriors dare approach.</string> <!-- untranslated -->
    <string name="boss_the_hollow_king_name">Szeryf-Upiór</string> <!-- untranslated -->
    <string name="boss_the_hollow_king_desc">The headless sovereign of the Gloomharvest, riding out from hangman\'s Woods to reap what the living have sown.</string> <!-- untranslated -->
    <string name="boss_the_vault_guardian_name">Pancerny Sejf Wells Fargo</string> <!-- untranslated -->
    <string name="boss_the_vault_guardian_desc">A colossus of living gold, woken by the lighting of the Eternal Flame. Only patrons of the Grand Monument may face it.</string> <!-- untranslated -->
    <string name="boss_obsidian_colossus_name">Parowy Kolos</string> <!-- untranslated -->
    <string name="boss_obsidian_colossus_desc">A mountain given wrath. No lone hero has ever chipped more than a scar into it. Bring a party.</string> <!-- untranslated -->
    <string name="boss_brood_empress_name">Królowa Skorpionów</string> <!-- untranslated -->
    <string name="boss_brood_empress_desc">Mother of the swarm between the stars. Her brood has ended armies; yours had better be paid well.</string> <!-- untranslated -->
    <string name="boss_the_world_ender_name">Pociąg Widmo</string> <!-- untranslated -->
    <string name="boss_the_world_ender_desc">When it stirs, kingdoms write their wills. Four names on the contract or none return.</string> <!-- untranslated -->

    <!-- ===== Expedition-unlocked dungeon names ===== -->
    <string name="dungeon_collapsed_mine_name">Zawalona Kopalnia Srebra</string>
    <string name="dungeon_collapsed_mine_desc">Rozległa jaskinia pod kopalniami miedzi. Trolle jaskiniowe i golemy skalne nawiedzają gruzy, a wielkie pająki snują sieci w zawalonych szybach.</string>
    <string name="dungeon_shadow_den_name">Melina Przemytników</string>
    <string name="dungeon_shadow_den_desc">Sieć podziemnych komnat wykorzystywana przez miejscowy cech złodziei. Łotrzykowie, zabójcy i cieniste stworzenia czają się w każdym kącie.</string>
    <string name="dungeon_abyssal_ruins_name">Ruiny Złotego Miasta Cibola</string>
    <string name="dungeon_abyssal_ruins_desc">Starożytne ruiny istniejące jednocześnie nad i pod płaszczyzną śmiertelników. Dziwne otchłanne stworzenia przenikają do i z rzeczywistości.</string>
    <string name="dungeon_ancient_forest_ruins_name">Ruiny Misji Hiszpańskiej</string>
    <string name="dungeon_ancient_forest_ruins_desc">Kamienne ruiny pochłonięte przez pierwotny las, nawiedzane teraz przez dzikie stworzenia i mściwe duchy druidów.</string>
    <string name="dungeon_ancient_forge_name">Huta Union Pacific</string>
    <string name="dungeon_ancient_forge_desc">Rozległa kornwalijska kuźnia, która płonie nieprzerwanie od wieków. Żywiołaki ognia i strażnicy kuźni chronią jej sekretów.</string>
    <string name="dungeon_arcane_ruins_name">Ruiny starej stacji telegrafu</string>
    <string name="dungeon_arcane_ruins_desc">Wciąż czynne podziemne komnaty zniszczonej wieży szarlatana. Wybuchowe konstrukty i zaklęci strażnicy wciąż patrolują jej korytarze.</string>
    <string name="dungeon_corrupted_sanctum_name">Kościół Fałszywego Proroka</string>
    <string name="dungeon_corrupted_sanctum_desc">Spowite cieniem sanktuarium w sercu skażonego baldachimu lasu. Mroczni kapłani i skażone bestie strzegą starożytnego zła.</string>
    <string name="dungeon_drowned_temple_name">Zatopione Miasteczko</string>
    <string name="dungeon_drowned_temple_desc">Zatopiona świątynia pod morską grotą, której korytarze wypełnia woda i morskie stworzenia, które uczyniły z niej swój dom.</string>
    <string name="dungeon_rogue_sanctum_name">Kryjówka Dziura w Ścianie</string>
    <string name="dungeon_rogue_sanctum_desc">Wewnętrzne schronienie gildii, dostępne tylko dla sprawdzonych członków.</string>
    <string name="dungeon_guild_of_shadows_name">Bractwo Rewolwerowców</string>
    <string name="dungeon_guild_of_shadows_desc">Najgłębsze sanktuarium gildii złodziei, strzeżone przez jej najbardziej elitarnych egzekutorów.</string>

