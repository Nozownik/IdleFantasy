    <!-- Elder Isle dungeons -->
    <string name="dungeon_beach_and_cliffs_name">Klify nad Rio Grande</string> <!-- untranslated -->
    <string name="dungeon_beach_and_cliffs_desc">The isle\'s landing zone. Coastal enemies scavenge the wrecks of prior voyages. Every clear has a chance to drop Ancient Sigils.</string> <!-- untranslated -->
    <string name="dungeon_ancient_forest_name">Sekwojowy Las</string> <!-- untranslated -->
    <string name="dungeon_ancient_forest_desc">A charge-laced jungle grown over an old library. Grove stalkers and charge-touched dryads keep visitors from the ruins beneath. Every clear has a chance to drop Ancient Sigils.</string> <!-- untranslated -->
    <string name="dungeon_volcano_peak_name">Szczyt Diabelskiej Góry</string> <!-- untranslated -->
    <string name="dungeon_volcano_peak_desc">The isle\'s smoking spine, once an Elder chapel. Ash beasts and lava wraiths guard the sealing site. Every clear has a chance to drop Ancient Sigils.</string> <!-- untranslated -->
    <string name="dungeon_abyssal_depths_name">Kopalnia bez dna</string> <!-- untranslated -->
    <string name="dungeon_abyssal_depths_desc">A flooded pressure-chamber at the foot of the isle, where the Last Shaman waits. Abyssal horrors and void seraphs patrol the approach. Every clear drops Ancient Sigils.</string> <!-- untranslated -->

    <!-- Elder Isle raid bosses -->
    <string name="boss_sea_serpent_name">Wąż Rzeczny z Missisipi</string> <!-- untranslated -->
    <string name="boss_sea_serpent_desc">The voyage boss. A charge-scarred serpent that circles the isle and turns back everyone it doesn\'t drown. Defeat once to permanently enable Set Sail.</string> <!-- untranslated -->
    <string name="boss_last_elder_name">Ostatni Szaman</string> <!-- untranslated -->
    <string name="boss_last_elder_desc">The last of the Elders, sealed at the bottom of the Bottomless Mine. Only a full Elder set can survive the fight.</string> <!-- untranslated -->
</resources>
